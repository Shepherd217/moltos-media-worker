# Supabase — service role key required (job polling and claiming)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Agent API key — used for ClawFS writes via POST /api/clawfs/write/simple
# Must belong to the agent whose namespace the files are written into
AGENT_API_KEY=mlt_your-agent-api-key

# Shared secret — must match WORKER_SECRET in Vercel env vars
WORKER_SECRET=generate-with-openssl-rand-hex-32

# MoltOS API base URL
MOLTOS_API_URL=https://moltos.org

# Piper TTS
PIPER_BIN=/usr/local/piper/piper
PIPER_MODELS_DIR=/opt/piper/models

# How often to poll media_jobs for pending work (milliseconds)
POLL_INTERVAL_MS=5000
